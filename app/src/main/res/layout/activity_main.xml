<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0d1321">

    <TextView
        android:id="@+id/txt_titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Régulateur Snap"
        android:textSize="26sp"
        android:textColor="#f0ebd8"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txt_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reprends le contrôle de ton temps. Active le service pour bloquer automatiquement l'onglet Spotlight."
        android:textColor="#748cab"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_activer_bloqueur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activer le bloqueur"
        android:textColor="#f0ebd8"
        android:textStyle="bold"
        android:backgroundTint="#3e5c76"
        android:padding="16dp"/>

</LinearLayout>